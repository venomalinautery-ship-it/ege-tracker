          ? `<div class="recs" style="color:var(--ok)">Все доступные задачи уже «✅» — красава!</div>` : "");
    const colorMap = { reached:"var(--ok)", close:"var(--warn)", medium:"var(--gold)", far:"var(--bad)", unavailable:"var(--muted)" };
    goalsHtml += `
      <div class="goal-card ${status}">
        <div class="top">
