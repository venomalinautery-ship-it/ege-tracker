// ===================== VIEW EVENTS =====================
document.getElementById("view").addEventListener("click", e => {
  const el = e.target.closest("[data-action]");
  if (!el) return;
  const action = el.dataset.action;

  if (action === "setSubject") {
    ui.subject = el.dataset.subj;
    ui.filter = "all";
    ui.query = "";
    render();
  }
  else if (action === "filter") {
    const f = el.dataset.f;
    ui.filter = ui.filter === f ? "all" : f;
    render();
  }
  else if (action === "mark") {
    const n = el.dataset.num, st = el.dataset.st;
    const subj = ui.subject;
    if (data.state[subj][n] === st) delete data.state[subj][n];
    else { data.state[subj][n] = st; registerStudyDay(); }
    saveData();
    render();
  }
  else if (action === "gotoTask") {
    ui.view = "tasks";
    ui.subject = el.dataset.subj;
    ui.filter = "all"; ui.query = "";
    render();
  }
  else if (action === "addGoal") {
    const univSel = document.querySelector('[data-action="univSelect"]');
    const progSel = document.querySelector('[data-action="progSelect"]');
    const typeSel = document.querySelector('[data-action="typeSelect"]');
    const goal = { univ: univSel.value, code: progSel.value, type: typeSel.value };
    if (data.goals.active.some(g => g.univ===goal.univ && g.code===goal.code && g.type===goal.type)) {
      alert("Такая цель уже есть"); return;
    }
    data.goals.active.push(goal);
    saveData(); render();
  }
  else if (action === "removeGoal") {
    const { univ, code, type } = el.dataset;
    data.goals.active = data.goals.active.filter(g => !(g.univ===univ && g.code===code && g.type===type));
    saveData(); render();
  }
  else if (action === "addMock") {
    const date = document.querySelector('[data-action="mockDate"]').value;
    const subj = document.querySelector('[data-action="mockSubject"]').value;
    const prim = parseInt(document.querySelector('[data-action="mockPrimary"]').value, 10);
    if (!date || !SUBJECTS[subj] || isNaN(prim) || prim < 0 || prim > SUBJECTS[subj].maxPrimary) {
      alert("Проверь данные"); return;
    }
    data.mocks.push({ date, subject: subj, primary: prim });
    registerStudyDay(); saveData(); render();
  }
  else if (action === "delMock") {
    const i = parseInt(el.dataset.idx, 10);
    if (!isNaN(i)) { data.mocks.splice(i, 1); saveData(); render(); }
  }
  else if (action === "plan") {
    const subj = ui.subject;
    const meta = SUBJECTS[subj];
    const st = data.state[subj];
    const c = counts(st, meta.tasks);
    const lines = [`📋 ПЛАН: ${meta.name}`, `Прогноз: ≈${testScore(subj, st)}/100 (порог ${meta.pass})`, ""];
    if (c.weak) {
      lines.push("❌ Сначала с нуля:");
      for (const n of Object.keys(meta.tasks).map(Number).sort((a,b)=>a-b))
        if (st[n] === "weak") lines.push(`   ${n}. ${meta.tasks[n][0]} (${meta.tasks[n][1]} б.)`);
      lines.push("");
    }
    if (c.learn) {
      lines.push("📈 Затем закрепить:");
      for (const n of Object.keys(meta.tasks).map(Number).sort((a,b)=>a-b))
        if (st[n] === "learn") lines.push(`   ${n}. ${meta.tasks[n][0]} (${meta.tasks[n][1]} б.)`);
      lines.push("");
    }
    if (!c.weak && !c.learn) lines.push("Размечай задачи 📈 и ❌ — здесь появится план.\n");
    lines.push("💎 Самые жирные:");
    for (const n of Object.keys(meta.tasks).map(Number).sort((a,b)=>meta.tasks[b][1]-meta.tasks[a][1]).slice(0,5))
      lines.push(`   ${n}. ${meta.tasks[n][0]} — ${meta.tasks[n][1]} перв.`);
    openModal(`<h3>📋 План: ${esc(meta.name)}</h3>
      <pre style="white-space:pre-wrap;font-family:inherit;font-size:13px;margin:0">${esc(lines.join("\n"))}</pre>
      <div class="modal-actions"><button class="btn" data-action="closeModal">Закрыть</button></div>`);
  }
  else if (action === "export") {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type:"application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `ege_tracker_${todayStr()}.json`;
    a.click();
  }
  else if (action === "import") {
    const input = document.createElement("input");
    input.type = "file"; input.accept = ".json,application/json";
    input.onchange = () => {
      const f = input.files[0]; if (!f) return;
      const r = new FileReader();
      r.onload = () => {
        try {
          const parsed = JSON.parse(r.result);
          if (confirm("Заменить текущий прогресс импортированным?")) {
            const base = blankData();
            base.state = { ...base.state, ...(parsed.state||{}) };
            base.notes = { ...base.notes, ...(parsed.notes||{}) };
            base.studyLog = parsed.studyLog || [];
            base.mocks    = parsed.mocks    || [];
            base.streak   = parsed.streak   || base.streak;
            base.goals    = parsed.goals    || base.goals;
            data = base; saveData(); render();
          }
        } catch (err) { alert("Ошибка файла: " + err.message); }
      };
      r.readAsText(f);
    };
    input.click();
  }
  else if (action === "reset") {
    if (confirm(`Сбросить прогресс по «${SUBJECTS[ui.subject].name}»?`)) {
      data.state[ui.subject] = {};
      data.notes[ui.subject] = {};
      saveData(); render();
    }
  }
  else if (action === "editNote") {
    const n = el.dataset.num;
    const subj = ui.subject;
    const cur = data.notes[subj][n] || "";
    openModal(`
      <h3>📝 Заметка к №${n}</h3>
      <div class="muted" style="margin-bottom:8px">${esc(SUBJECTS[subj].tasks[n][0])}</div>
      <textarea id="noteInput" placeholder="Что запомнить...">${esc(cur)}</textarea>
      <div class="modal-actions">
        <button class="btn" data-action="closeModal">Отмена</button>
        <button class="btn primary" data-action="saveNote" data-num="${n}">Сохранить</button>
      </div>`);
    setTimeout(() => document.getElementById("noteInput")?.focus(), 50);
  }
});

document.getElementById("view").addEventListener("change", e => {
  const el = e.target.closest("[data-action]");
  if (!el) return;
  const a = el.dataset.action;
  if (a === "sort") { ui.sort = el.value; render(); }
  else if (a === "univSelect") populatePrograms();
});

document.getElementById("view").addEventListener("input", e => {
  const el = e.target.closest('[data-action="search"]');
  if (el) {
    ui.query = el.value.trim().toLowerCase();
    const list = document.getElementById("taskList");
    if (list) {
      const subj = ui.subject;
      const meta = SUBJECTS[subj];
      const st = data.state[subj] || {};
      const rows = [];
      for (const n of Object.keys(meta.tasks).map(Number).sort((a,b)=>a-b)) {
        const s = st[n] || "none";
        if (ui.filter !== "all" && s !== ui.filter) continue;
        const [topic, pts] = meta.tasks[n];
        if (ui.query && !topic.toLowerCase().includes(ui.query)) continue;
        const note = (data.notes[subj] || {})[n] || "";
        const scale = meta.scale[Math.min(pts, meta.maxPrimary)];
        rows.push(`
          <div class="task ${s}" data-num="${n}">
            <div class="num">${n}</div>
            <div class="info" data-action="editNote" data-num="${n}">
              <div class="title">${esc(topic)}${note?" 📝":""}</div>
              <div class="meta">${pts} перв. · ≈${scale} тест.</div>
            </div>
            <div class="actions">
              ${["know","learn","weak"].map(x =>
                `<button data-action="mark" data-num="${n}" data-st="${x}" class="${s===x?"active":""}">${STATUS_META[x].sym}</button>`
              ).join("")}
            </div>
          </div>`);
      }
      list.innerHTML = rows.join("") || '<div class="center">Ничего не найдено</div>';
    }
  }
  const mP = e.target.closest('[data-action="mockPrimary"]');
  if (mP) {
    const subj = document.querySelector('[data-action="mockSubject"]').value;
    const meta = SUBJECTS[subj];
    const p = Math.max(0, Math.min(parseInt(mP.value) || 0, meta.maxPrimary));
    const prev = document.getElementById("mockPreview");
    if (prev) prev.textContent = `→ ${meta.scale[p]} тест. баллов`;
  }
});

