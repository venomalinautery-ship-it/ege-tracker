function renderMocks() {
  const subjOptions = Object.entries(SUBJECTS).map(([k, m]) =>
    `<option value="${k}">${m.name}</option>`).join("");
  let listHtml = "";
  for (const [subjK, meta] of Object.entries(SUBJECTS)) {
    const ms = data.mocks.filter(m => m.subject === subjK).sort((a,b) => (a.date||"").localeCompare(b.date||""));
    if (!ms.length) continue;
    const W = 320, H = 80, PAD = 8;
    let points = ms.map((m, i) => {
      const prim = Math.max(0, Math.min(m.primary, meta.maxPrimary));
      const test = meta.scale[prim];
      const x = PAD + (W - 2*PAD) * (i / Math.max(ms.length - 1, 1));
      const y = H - PAD - (H - 2*PAD) * (test / 100);
      return { x, y, test, prim, date: m.date };
    });
    let path = points.map((p, i) => (i ? "L" : "M") + p.x + " " + p.y).join(" ");
    const passY = H - PAD - (H - 2*PAD) * (meta.pass / 100);
    const svg = `
      <svg class="mock-chart" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
        <line x1="0" y1="${passY}" x2="${W}" y2="${passY}" stroke="var(--bad)" stroke-dasharray="3,3" stroke-width="1"/>
        <text x="${W-4}" y="${passY-4}" fill="var(--bad)" font-size="9" text-anchor="end">порог ${meta.pass}</text>
        <path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2"/>
        ${points.map(p => `<circle cx="${p.x}" cy="${p.y}" r="3" fill="var(--accent)"/>`).join("")}
      </svg>`;
    const rows = ms.slice(-5).reverse().map(m => {
      const i = ms.indexOf(m);
      const prim = Math.max(0, Math.min(m.primary, meta.maxPrimary));
      const test = meta.scale[prim];
      const col = test >= meta.pass ? "var(--ok)" : (test >= meta.pass*0.6 ? "var(--warn)" : "var(--bad)");
      return `<div class="mock-row">
        <span>${esc(m.date || "—")}</span>
        <span style="color:${col}">перв. ${prim} → тест. ${test}</span>
        <button data-action="delMock" data-idx="${i}" style="background:none;border:0;color:var(--bad);font-size:14px">✕</button>
      </div>`;
    }).join("");
    listHtml += `
      <div class="card">
        <div style="display:flex;justify-content:space-between;margin-bottom:4px">
          <b>${meta.name}</b>
          <span class="muted">${ms.length} записей</span>
        </div>
        ${svg}
        ${rows}
      </div>`;
  }
  return `
    <h2>➕ Добавить пробник</h2>
    <div class="card">
      <label>Дата</label>
      <input type="date" data-action="mockDate" value="${todayStr()}">
      <label>Предмет</label>
      <select data-action="mockSubject">${subjOptions}</select>
      <label>Первичный балл</label>
      <input type="number" data-action="mockPrimary" min="0" value="0" inputmode="numeric">
      <div class="muted" id="mockPreview" style="margin-top:6px">→ 0 тест. баллов</div>
      <button class="btn primary full" style="margin-top:12px" data-action="addMock">Добавить</button>
    </div>
    ${listHtml || '<div class="center">Пока нет записей</div>'}
  `;
}

