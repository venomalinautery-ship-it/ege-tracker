  for (const n of Object.keys(tasks)) {
    const s = (state || {})[n];
    if (s === "know" || s === "learn" || s === "weak") c[s]++;
    else c.none++;
  }
  return c;
}
function daysUntilExam() {
  const today = new Date();
  let exam = new Date(today.getFullYear(), 4, 25);
  if (exam <= today) exam = new Date(today.getFullYear() + 1, 4, 25);
  return Math.ceil((exam - today) / 86400000);
}
function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function registerStudyDay() {
  const today = todayStr();
  const st = data.streak;
  if (st.last === today) return;
  const y = new Date(); y.setDate(y.getDate() - 1);
  const yStr = `${y.getFullYear()}-${String(y.getMonth()+1).padStart(2,"0")}-${String(y.getDate()).padStart(2,"0")}`;
  if (st.last === yStr) st.count = (st.count || 0) + 1;
  else st.count = 1;
  st.last = today;
}
function totalStudySeconds(subject, sinceDate) {
  let total = 0;
  for (const it of data.studyLog) {
    if (subject && it.subject !== subject) continue;
    if (sinceDate && (it.date || "") < sinceDate) continue;
    total += it.seconds || 0;
  }
  return total;
}
function fmtDuration(sec) {
  sec = Math.floor(sec);
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  if (h > 0) return `${h} ч ${m} мин`;
  return `${m} мин`;
}
function goalGap(scores, goal) {
  const univ = UNIVERSITIES[goal.univ];
  if (!univ) return [0,0,0,"unknown"];
  const prog = univ.programs.find(p => p.code === goal.code);
  if (!prog) return [0,0,0,"unknown"];
  const current = Object.values(scores).reduce((a,b)=>a+b, 0);
  const needed = prog[goal.type];
  if (needed <= 0) return [current, needed, 0, "unavailable"];
  const diff = needed - current;
  const status = diff <= 0 ? "reached" : diff <= 20 ? "close" : diff <= 50 ? "medium" : "far";
  return [current, needed, diff, status];
}
function goalRecommendations(scores, goal) {
  const univ = UNIVERSITIES[goal.univ];
  if (!univ) return [];
  const prog = univ.programs.find(p => p.code === goal.code);
  if (!prog || prog[goal.type] <= 0) return [];
  const deficit = prog[goal.type] - Object.values(scores).reduce((a,b)=>a+b, 0);
  if (deficit <= 0) return [];
  const recs = [];
  for (const [subjKey, meta] of Object.entries(SUBJECTS)) {
    const st = data.state[subjKey] || {};
    const cands = [];
    for (const [n, [topic, pts]] of Object.entries(meta.tasks)) {
      const s = st[n];
      if (s === "know") continue;
      const gain = s === "learn" ? pts / 2 : pts;
      cands.push({ n:+n, topic, pts, gain, status: s || "none" });
    }
    cands.sort((a,b) => b.gain - a.gain);
    let total = 0;
    for (const c of cands) {
      if (total >= deficit) break;
      total += c.gain;
      recs.push({ subject: meta.name, subjKey, ...c });
    }
  }
  return recs;
}
function computeAchievements() {
  const A = [];
  const states = data.state;
  let totalKnow = 0;
  for (const k of Object.keys(SUBJECTS)) totalKnow += counts(states[k], SUBJECTS[k].tasks).know;
  const anyMarked = Object.values(states).some(s => Object.keys(s).length > 0);
  const allKnowFull = Object.keys(SUBJECTS).some(k =>
    counts(states[k], SUBJECTS[k].tasks).know === Object.keys(SUBJECTS[k].tasks).length);
  const scores = {};
  for (const k of Object.keys(SUBJECTS)) scores[k] = testScore(k, states[k]);
  const totalTime = totalStudySeconds();
  const streak = data.streak.count || 0;
  A.push(["🎯", "Первый шаг",    "Отметить хотя бы одну задачу", anyMarked]);
  A.push(["🔥", "Разогрев",      "10 задач на «✅ Умею»",         totalKnow >= 10]);
  A.push(["🧠", "Знаток",        "50 задач на «✅ Умею»",         totalKnow >= 50]);
  A.push(["📚", "Всезнайка",     "Все задачи одного предмета",    allKnowFull]);
  A.push(["💪", "Марафонец",     "7 дней занятий подряд",         streak >= 7]);
  A.push(["⏱️", "Трудяга",       "10 часов учёбы",                totalTime >= 10*3600]);
  A.push(["📈", "Прорыв",        "70+ баллов в любом предмете",   Object.values(scores).some(s => s >= 70)]);
  A.push(["🏆", "Отличник",      "80+ баллов в любом предмете",   Object.values(scores).some(s => s >= 80)]);
  let goalClose = false, goalReached = false;
  for (const g of data.goals.active) {
    const [, , diff, status] = goalGap(scores, g);
    if (status === "reached") goalReached = true;
    if (diff <= 20 && status !== "unavailable") goalClose = true;
  }
  A.push(["🎓", "Цель рядом",       "До цели ≤ 20 баллов",     goalClose || goalReached]);
  A.push(["✅", "Цель достигнута",  "Прогноз дотянул до цели", goalReached]);
  return A;
}
function pickNextTask() {
  const cands = [];
  for (const [subj, meta] of Object.entries(SUBJECTS)) {
    const st = data.state[subj] || {};
    for (const [n, [topic, pts]] of Object.entries(meta.tasks)) {
      const status = st[n] || "none";
      if (status === "know") continue;
      const prio = { weak:0, none:1, learn:2 }[status];
      cands.push({ subj, subjectName: meta.name, n:+n, topic, pts, status, score: prio*100 - pts*10 });
    }
  }
  if (!cands.length) return null;
  cands.sort((a,b) => a.score - b.score);
  return cands[0];
}

