const LS_KEY = "ege_pro_tracker_v1";
function blankData() {
  return {
    state:   { math:{}, rus:{}, inf:{} },
    notes:   { math:{}, rus:{}, inf:{} },
    studyLog:[],
    mocks:   [],
    streak:  { last:null, count:0 },
    goals:   { active:[] },
  };
}
function loadData() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return blankData();
    const d = JSON.parse(raw);
    const base = blankData();
    base.state   = { math:{}, rus:{}, inf:{}, ...(d.state || {}) };
    base.notes   = { math:{}, rus:{}, inf:{}, ...(d.notes || {}) };
    base.studyLog= Array.isArray(d.studyLog) ? d.studyLog : [];
    base.mocks   = Array.isArray(d.mocks)    ? d.mocks    : [];
    base.streak  = d.streak || { last:null, count:0 };
    base.goals   = d.goals  || { active:[] };
    return base;
  } catch (e) { return blankData(); }
