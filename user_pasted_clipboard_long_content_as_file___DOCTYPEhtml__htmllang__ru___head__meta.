function estPrimary(subj, state) {
  let total = 0;
  const tasks = SUBJECTS[subj].tasks;
  for (const [n, st] of Object.entries(state || {})) {
    const t = tasks[n];
    if (!t) continue;
    const pts = t[1];
    if (st === "know")  total += pts;
    else if (st === "learn") total += pts / 2;
  }
  return total;
}
function testScore(subj, state) {
  let p = Math.round(estPrimary(subj, state));
  const max = SUBJECTS[subj].maxPrimary;
  p = Math.max(0, Math.min(p, max));
  return SUBJECTS[subj].scale[p];
}
