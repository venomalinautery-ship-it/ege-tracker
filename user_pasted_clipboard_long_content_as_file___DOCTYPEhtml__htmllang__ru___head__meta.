          <span style="font-size:11px;color:var(--muted);flex-shrink:0">${typeLabel}</span>
        </div>
        <div class="status" style="color:${colorMap[status]}">Прогноз: ${cur} / ${needed} · ${statusText}</div>
        <div class="bar" style="color:${colorMap[status]}"><span style="width:${frac}%;background:${colorMap[status]}"></span></div>
        ${prog.cost ? `<div class="prog" style="margin-top:6px">💰 ${prog.cost.toLocaleString("ru")} ₽/год</div>` : ""}
        ${recsHtml}
        <div style="text-align:right;margin-top:8px">
          <button class="btn danger" style="padding:6px 10px;font-size:11px"
