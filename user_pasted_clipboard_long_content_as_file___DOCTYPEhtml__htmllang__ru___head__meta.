    const typeLabel = goal.type === "budget" ? "🎓 Бюджет" : "💰 Платное";
    const frac = needed > 0 ? Math.min(cur/needed, 1) * 100 : 0;
    const recs = goalRecommendations(scores, goal).slice(0, 6);
