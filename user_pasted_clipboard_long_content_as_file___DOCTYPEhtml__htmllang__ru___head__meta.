      ? `<div class="recs"><b style="color:var(--accent)">💡 Что подтянуть:</b>${
          recs.map(r => `<div>${STATUS_META[r.status].sym} ${esc(r.subject)} №${r.n}: ${esc(r.topic)} (+${r.gain.toFixed(1)})</div>`).join("")
